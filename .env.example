SORTAX_APP_ENV=development
SORTAX_JWT_SECRET=replace-with-at-least-32-random-characters
SORTAX_JWT_ISSUER=sortax-dev
SORTAX_JWT_AUDIENCE=sortax-api
SORTAX_JWT_TTL_SECONDS=3600
SORTAX_LOG_LEVEL=INFO
SORTAX_DATABASE_ENABLED=true
SORTAX_POSTGRES_PASSWORD=replace-with-a-local-postgres-password
SORTAX_DATABASE_URL=postgresql+asyncpg://sortax:replace-with-a-local-postgres-password@localhost:5432/sortax
SORTAX_REDIS_URL=redis://localhost:6379/0
SORTAX_REDIS_ENABLED=true
SORTAX_CELERY_BROKER_URL=redis://localhost:6379/1
SORTAX_CELERY_RESULT_BACKEND=redis://localhost:6379/2
SORTAX_LLM_PROVIDER=fake
SORTAX_LLM_MODEL=fake-chat-v1
# Used only when SORTAX_LLM_PROVIDER=qwen.
SORTAX_QWEN_BASE_URL=https://maas.qianwenaiapi.com/compatible-mode/v1
# SORTAX_QWEN_API_KEY=
SORTAX_LLM_REQUEST_TIMEOUT_SECONDS=60
SORTAX_LLM_MAX_OUTPUT_TOKENS=1024
# Set to qwen to enable the Phase 5C.1 classifier. It reuses SORTAX_QWEN_API_KEY
# and SORTAX_QWEN_BASE_URL but has an independently selected model.
SORTAX_INTENT_CLASSIFIER_PROVIDER=fake
SORTAX_CLASSIFIER_MODEL=fake-intent-v1
SORTAX_CLASSIFIER_TIMEOUT_SECONDS=10
SORTAX_CLASSIFIER_MAX_OUTPUT_TOKENS=96
SORTAX_FIRST_TOKEN_TIMEOUT_SECONDS=30
SORTAX_STREAM_HEARTBEAT_SECONDS=15
SORTAX_STREAM_MAX_DURATION_SECONDS=300
SORTAX_CANCELLATION_POLL_SECONDS=0.5
SORTAX_CANCELLATION_TTL_SECONDS=600
# Set only when SORTAX_LLM_PROVIDER=openai.
# SORTAX_LLM_API_KEY=
SORTAX_MILVUS_ENABLED=true
SORTAX_MILVUS_URI=http://localhost:19530
SORTAX_MILVUS_DATABASE=default
SORTAX_MILVUS_COLLECTION=ato_knowledge_demo
SORTAX_MILVUS_CONNECT_TIMEOUT_SECONDS=5
SORTAX_ATO_DATA_DIR=data/ato
SORTAX_ATO_MANIFEST_PATH=manifests/ato/sources.yaml
SORTAX_EMBEDDING_PROVIDER=fake
SORTAX_EMBEDDING_MODEL=fake-embedding-v1
SORTAX_EMBEDDING_DIMENSIONS=64
SORTAX_EMBEDDING_BATCH_SIZE=64
SORTAX_RETRIEVAL_TOP_K=5
SORTAX_RETRIEVAL_SCORE_THRESHOLD=0.15
SORTAX_KNOWLEDGE_MAX_FILE_BYTES=10485760
SORTAX_KNOWLEDGE_CHUNK_SIZE=1200
SORTAX_KNOWLEDGE_CHUNK_OVERLAP=200
# Set only when an explicitly configured real Embedding Provider requires it.
# SORTAX_EMBEDDING_API_KEY=
